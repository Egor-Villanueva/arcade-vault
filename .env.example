# Clave de la API de Resend (https://resend.com/api-keys). Solo servidor.
RESEND_API_KEY=

# Quién recibe los mensajes del formulario de contacto.
# Con el remitente de pruebas (onboarding@resend.dev) Resend solo entrega
# al correo dueño de la cuenta; cualquier otro destinatario devuelve 403.
CONTACT_TO_EMAIL=

# Remitente. Por defecto, el de pruebas de Resend.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
